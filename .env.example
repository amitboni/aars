# Database
DATABASE_URL=postgresql+asyncpg://aars:aars_dev@localhost:5432/aars
DATABASE_URL_SYNC=postgresql+psycopg2://aars:aars_dev@localhost:5432/aars

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=480

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_RECORDINGS=recordings
S3_BUCKET_TRAINING=training-content

# Channel Providers
VOICE_PROVIDER=mock
WHATSAPP_PROVIDER=mock

# WhatsApp Provider Config
WHATSAPP_API_KEY=
WHATSAPP_API_URL=
WHATSAPP_WEBHOOK_SECRET=

# Voice Provider Config
VOICE_API_KEY=
VOICE_API_URL=
VOICE_WEBHOOK_SECRET=

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1

# Environment
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# CORS
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
